# Omamori Spa Frontend Environment Configuration

# API Configuration
VITE_API_URL=http://localhost:3000/api/v1

# Mock Authentication (for development)
# Set to 'false' to use real API
VITE_USE_MOCK_AUTH=true

# Mock Catalog Data (services / cosmetics / therapists / rooms)
# Set to 'false' once the backend exposes /services, /cosmetics,
# /therapists and /rooms so the public pages use the real API.
VITE_USE_MOCK_DATA=true