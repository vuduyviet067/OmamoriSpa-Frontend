# Omamori Spa Frontend Environment Configuration

# API Configuration
# IMPORTANT: Do not use port 5173 (Vite dev server) as the API base URL.
# Backend must run on a different port. Update this to match your backend server.
# Example: http://localhost:3000/api  or  http://localhost:8080/api
VITE_API_URL=http://localhost:3000/api

# Mock Authentication (for development)
# Set to 'false' to use real API for /auth/login, /auth/register, /auth/me, /auth/refresh
VITE_USE_MOCK_AUTH=true

# Mock Catalog & Business Data
# Set to 'true' (default) to use mock data from src/mocks/
# Set to 'false' to fetch all data from the real backend API.
# When false, 404 errors from lookup endpoints (rooms, therapists, time-slots)
# are surfaced as errors instead of silently returning empty arrays.
VITE_USE_MOCK_DATA=true
