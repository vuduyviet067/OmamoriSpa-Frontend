# Omamori Spa Frontend Environment Configuration

# API Configuration
# IMPORTANT: Do not use port 5173 (Vite dev server) as the API base URL.
# Backend must run on a different port. Update this to match your backend server.
# FINAL Backend Gateway base: http://localhost:8888/api/omamori
VITE_API_URL=http://localhost:8888/api/omamori

# Mock Authentication (for development)
# Set to 'false' to use real API for /auth/login, /auth/register, /auth/me, /auth/refresh
VITE_USE_MOCK_AUTH=true

# Mock Public Catalog (services, cosmetics)
# Set to 'false' to use real backend API for PUBLIC service/cosmetic catalog.
# Set to 'true' (default) to use mock data from src/mocks/
# NOTE: Rooms and Therapists remain mock for Phase 2.
VITE_USE_MOCK_PUBLIC=true

# Legacy flag - deprecated, use VITE_USE_MOCK_PUBLIC instead
# When true, all non-auth data uses mocks (services, cosmetics, rooms, therapists)
# When false, services/cosmetics use real backend, rooms/therapists remain mock
# VITE_USE_MOCK_DATA=true

# Customer Profile
# Set to 'false' to use real backend GET/PUT /profiles/me
# Set to 'true' to use customer profile mock data
VITE_USE_MOCK_PROFILE=false

# Customer Profile
# Set to 'false' to use real backend GET/PUT /profiles/me
# Set to 'true' to use customer profile mock data
VITE_USE_MOCK_PROFILE=false

# Customer Booking - Rooms
# Set to 'false' to load authenticated rooms from GET /rooms/
VITE_USE_MOCK_ROOMS=false

# Customer Booking - Therapists
# Set to 'false' to load authenticated therapists from GET /profiles/therapists
VITE_USE_MOCK_THERAPISTS=false

# Customer Booking - Services
# Set to 'false' to load real services from GET /treatments/
VITE_USE_MOCK_SERVICES=false

# Customer Appointments
# Set to 'false' to use authenticated /appointments/me endpoints
VITE_USE_MOCK_APPOINTMENTS=false

# Customer Transactions
# Set to 'false' to load authenticated customer invoices from /payments/me
VITE_USE_MOCK_TRANSACTIONS=false

# Therapist Portal
# Set to 'false' to use real backend /appointments/therapist/me endpoints
# Set to 'true' to fall back to src/mocks therapist data
VITE_USE_MOCK_THERAPIST=false

# Admin Users (Customers & Therapists)
# Set to 'false' to use real backend /users endpoint for customer/therapist management
# Set to 'true' to fall back to src/mocks admin data
VITE_USE_MOCK_ADMIN_USERS=true

# Admin Catalog - Services (P2-B1)
# Set to 'false' to call the real treatment-service /treatments/ endpoints
# Set to 'true' to fall back to the in-memory mock (isolated from the global
# VITE_USE_MOCK_DATA flag so Room / Cosmetic / Invoice / Report can stay on
# mocks while this catalog view integrates with the real backend).
VITE_USE_MOCK_ADMIN_CATALOG_SERVICES=false
